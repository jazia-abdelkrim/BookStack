PORT=5001
NODE_ENV=development
# Required in production: long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
# Comma-separated origins allowed by CORS (only needed if the frontend is on another domain)
FRONTEND_URL=http://localhost:5173,http://localhost:5174,http://localhost:5183
# Admin account created/promoted on startup (password min 10 chars in production)
ADMIN_EMAIL=admin@yourstore.com
ADMIN_PASSWORD=change-this-strong-password
# Where db.json lives. Point at a persistent disk in production, e.g. /var/data
# DATA_DIR=/var/data
# Set to true when behind a reverse proxy / PaaS (Render, Railway, Fly, Nginx) so rate limiting sees real IPs
# TRUST_PROXY=true
